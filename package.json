{
  "name": "cacau-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:db:up": "docker compose -f docker-compose.e2e.yaml up -d --wait",
    "e2e:db:down": "docker compose -f docker-compose.e2e.yaml down",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
