# Template das variáveis do deploy de produção (docker-compose.prod.yaml).
# Copie para `.env` no VPS e preencha com valores reais.
# `.env` nunca é versionado (ver .gitignore) — nenhum segredo real entra no repositório.

# --- Domínio / TLS -----------------------------------------------------------
# Domínio público do PWA. Com um domínio real, o Caddy emite o certificado
# Let's Encrypt automaticamente. Use `:80` (HTTP puro, sem certificado) apenas
# para o smoke test local do stack.
SITE_ADDRESS=notas.exemplo.com.br
# E-mail de contato da conta ACME (avisos de expiração do Let's Encrypt).
TLS_EMAIL=ti@exemplo.com.br
# Origem pública completa; vira o `FRONTEND_ORIGIN` (CORS) do backend.
PUBLIC_ORIGIN=https://notas.exemplo.com.br

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=cacau
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cacau
# Aponta para o serviço `postgres` da rede do compose; schema default (`public`).
DATABASE_URL=postgres://cacau:troque-esta-senha@postgres:5432/cacau

# --- Backend -----------------------------------------------------------------
# Segredo de assinatura da sessão JWT (ADR-009). Gere um valor aleatório longo:
#   openssl rand -base64 48
JWT_SECRET=troque-este-segredo
# Código da loja na API interna da Cacau Show
EMPRESA_CODE=
# Base da API de NFe. Só mude para apontar a um fixture/túnel.
NFE_BASE_URL=

# --- Conta admin (bootstrap, ADR-001) ----------------------------------------
# Lidas apenas por `npm run bootstrap:admin -w backend`, que roda uma vez após o
# primeiro deploy para criar a conta admin única. Nenhuma rota da aplicação cria
# admin. A senha abaixo é provisória: o primeiro login exige trocá-la (ADR-002).
# Política: mínimo 8 caracteres, ao menos 1 dígito.
ADMIN_NAME=
ADMIN_EMAIL=
# Somente dígitos ou com pontuação; o dígito verificador é validado.
ADMIN_CPF=
# Formato YYYY-MM-DD.
ADMIN_BIRTH_DATE=
ADMIN_PASSWORD=

# Freio de força bruta do POST /auth/login: tentativas por janela e tamanho da janela,
# contadas por par (IP, e-mail) em memória no processo. `0` desliga o limite.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_SECONDS=60
